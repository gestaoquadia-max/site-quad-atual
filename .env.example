# URL base da API (Java).
# Desenvolvimento: http://localhost:8080
# Produção (AWS): https://api.quadconcursos.com.br
NEXT_PUBLIC_API_URL=

# Endereço público do site (sem barra no fim). Base dos links de compartilhamento, do sitemap e do endereço canônico.
# Sem valor, usa https://quadconcursos.com.br
NEXT_PUBLIC_SITE_URL=

# Client ID do Google (tipo "Aplicativo da Web", o mesmo do app e do GOOGLE_CLIENT_IDS da API). Não é segredo.
# Sem valor, o botão "Continuar com o Google" não aparece. A origem do site precisa estar autorizada no Google Cloud.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
